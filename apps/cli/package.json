{
  "name": "@runwitness/cli",
  "version": "0.1.0",
  "private": false,
  "description": "Command-line interface for RunWitness.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
