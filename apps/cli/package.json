  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@runwitness/adapters": "0.1.0",
    "@runwitness/core": "0.1.0",
    "@runwitness/policy": "0.1.0",
    "@runwitness/sandbox": "0.1.0",
    "@runwitness/skills": "0.1.0",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  }
}
