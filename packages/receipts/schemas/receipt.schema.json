{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runwitness.local/schemas/receipt.schema.json",
  "title": "RunWitness Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "task",
    "agent",
    "run",
    "files",
    "commands",
    "tests",
    "approvals",
    "artifacts",
    "fileTracking",
    "summary",
    "timeline"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "workspace"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "startedAt"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["running", "completed", "failed", "blocked"]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRecord"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandRecord"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testRecord"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approvalRecord"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRecord"
      }
    },
    "policy": {
      "$ref": "#/$defs/policyLineage"
    },
    "fileTracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ignoredNames"],
      "properties": {
        "ignoredNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineEvent"
      }
    }
  },
  "$defs": {
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": ["created", "modified", "deleted"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commandRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exitCode", "status"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string"
        },
        "exitCode": {
          "type": ["integer", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "blocked"]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "testRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "status"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "blocked"]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["granted", "denied", "not_required", "pending"]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "artifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "policyLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precedence", "layers", "protectedSourcePaths"],
      "properties": {
        "digest": {
          "$ref": "#/$defs/policyDigest"
        },
        "precedence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policyLayer"
          }
        },
        "protectedSourcePaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protectedPolicyPath"
          }
        }
      }
    },
    "policyLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protectedPaths"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "precedence": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/policyDigest"
        },
        "sourceLength": {
          "type": "integer",
          "minimum": 0
        },
        "protectedPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protectedPolicyPath"
          }
        }
      }
    },
    "policyDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "protectedPolicyPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "commands", "tests", "approvals"],
      "properties": {
        "files": {
          "$ref": "#/$defs/countSummary"
        },
        "commands": {
          "$ref": "#/$defs/countSummary"
        },
        "tests": {
          "$ref": "#/$defs/countSummary"
        },
        "approvals": {
          "$ref": "#/$defs/countSummary"
        }
      }
    },
    "countSummary": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "required": ["total"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "timestamp"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "stepId": {
          "type": "string"
        }
      }
    }
  }
}
