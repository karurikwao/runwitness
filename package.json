{
  "name": "runwitness",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous agents with receipts.",
  "license": "Apache-2.0",
  "keywords": [
    "agents",
    "receipts",
    "policy",
    "sandbox",
    "audit",
    "cli"
  ],
  "type": "module",
  "bin": {
    "runwitness": "./dist/apps/cli/src/bin.js"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.19",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/sync-package-dist.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:config": "tsc --showConfig -p tsconfig.json",
    "test": "vitest run",
    "rw": "tsx apps/cli/src/bin.ts",
    "verify": "npm run check && npm run test && npm run build && npm run release:check:built",
    "release:check": "node scripts/check-package-release.mjs",
    "release:check:built": "node scripts/check-package-release.mjs --built",
    "pack:dry-run": "npm pack --workspaces --dry-run --json",
    "release:pack": "npm run build && npm run release:check:built && npm run pack:dry-run",
    "workspaces:list": "npm query .workspace"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "sql.js": "^1.13.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/sql.js": "^1.4.9",
    "ajv": "^8.20.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
